# Template for REAL team services. Replace every placeholder and agree contracts.
APP_ENV=development
BACKEND_MODE=http
API_KEY=replace-with-gateway-key
PERSON2_BASE_URL=http://127.0.0.1:8001
AI_BASE_URL=http://127.0.0.1:8002
PERSON2_SERVICE_TOKEN=replace-with-p2-inbound-token
AI_SERVICE_TOKEN=replace-with-ai-inbound-token
DOCUMENT_DISPATCH_TOKEN=replace-with-upload-dispatch-token
AI_CALLBACK_TOKEN=replace-with-ai-result-token
INTERNAL_SERVICE_TOKEN=replace-with-operations-token
CAPTURE_REQUIRED=true
CORS_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
# Semantic retrieval. EMBEDDING_PROVIDER=fastembed embeds in-process and needs the
# optional embeddings extra. EMBEDDING_PROVIDER=http requires EMBEDDING_BASE_URL
# and EMBEDDING_SERVICE_TOKEN pointing at POST /internal/v1/embeddings.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BASE_URL=
EMBEDDING_SERVICE_TOKEN=
# APP_ENV=production requires all six keys above to be unique, non-placeholder
# values of at least 32 characters. Generate them with Python's secrets module.
# App defaults cover timeout, size and rate settings; tune to your deployment.
