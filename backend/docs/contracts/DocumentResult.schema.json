{
  "$defs": {
    "ExtractedQuestion": {
      "additionalProperties": false,
      "description": "AI-local ID; Person 2 assigns canonical question IDs during ingestion.",
      "properties": {
        "extraction_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Extraction Id",
          "type": "string"
        },
        "text": {
          "maxLength": 15000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "subject": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "module": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Module"
        },
        "topic": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "source": {
          "$ref": "#/$defs/SourceReference"
        },
        "official_solution": {
          "anyOf": [
            {
              "maxLength": 30000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Solution"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "needs_review": {
          "default": true,
          "title": "Needs Review",
          "type": "boolean"
        }
      },
      "required": [
        "extraction_id",
        "text",
        "subject",
        "source"
      ],
      "title": "ExtractedQuestion",
      "type": "object"
    },
    "JobFailure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JobFailure",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "document_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "document_title": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Title"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        },
        "question_number": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question Number"
        },
        "year": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1990,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "source_type"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "tutorial",
        "pyq",
        "practice"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Document Id",
      "type": "string"
    },
    "document_version": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Document Version",
      "type": "string"
    },
    "source_type": {
      "$ref": "#/$defs/SourceType"
    },
    "client_job_key": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Client Job Key",
      "type": "string"
    },
    "event_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Event Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/ExtractedQuestion"
      },
      "maxItems": 100,
      "title": "Questions",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobFailure"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "document_id",
    "document_version",
    "source_type",
    "client_job_key",
    "event_id",
    "status"
  ],
  "title": "DocumentResult",
  "type": "object"
}
