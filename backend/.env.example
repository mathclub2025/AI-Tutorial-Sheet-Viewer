# Local sample questions and canned answers. No external services required.
APP_ENV=development
BACKEND_MODE=demo
API_KEY=local-dev-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
CAPTURE_REQUIRED=false

# HTTP mode requires both peer services; see .env.http.example.
UPSTREAM_TIMEOUT_SECONDS=15
REQUEST_TIMEOUT_SECONDS=45
HEALTH_TIMEOUT_SECONDS=2
UPSTREAM_READ_RETRIES=1
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30
UPSTREAM_MAX_RESPONSE_BYTES=4194304
MAX_REQUEST_BYTES=65536
MAX_INTERNAL_REQUEST_BYTES=4194304
REQUEST_BODY_TIMEOUT_SECONDS=15
RATE_LIMIT_PER_MINUTE=120
INTERNAL_RATE_LIMIT_PER_MINUTE=300

# Person 2 data-service token. Configure the identical secret as
# PERSON2_SERVICE_TOKEN for the Person 1 API and PERSON2_INBOUND_TOKEN here.
PERSON2_SERVICE_TOKEN=replace-with-shared-person2-token
PERSON2_INBOUND_TOKEN=replace-with-shared-person2-token

# Optional persistence and B2 services for the combined deployment.
# Start compose.postgres.yml, then replace the local-only password placeholder.
DATABASE_URL=postgresql+psycopg://mathclub:replace-with-local-password@127.0.0.1:5432/mathclub
POSTGRES_USER=mathclub
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=mathclub

# Semantic retrieval. EMBEDDING_PROVIDER=fastembed embeds in-process and needs the
# optional embeddings extra. EMBEDDING_PROVIDER=http requires EMBEDDING_BASE_URL
# and EMBEDDING_SERVICE_TOKEN pointing at POST /internal/v1/embeddings.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BASE_URL=
EMBEDDING_SERVICE_TOKEN=

# Leave B2 values blank to disable storage configuration.
B2_ENDPOINT_URL=
B2_BUCKET_NAME=
B2_ACCESS_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=eu-central-003
CLOUDFLARE_DELIVERY_BASE_URL=
B2_SIGNED_URL_EXPIRY_SECONDS=900
MAX_UPLOAD_BYTES=52428800
