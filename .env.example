# Google Gemini API Key for vision-based math extraction
GEMINI_API_KEY=your_gemini_api_key_here

# Model name (e.g., gemini-3.1-flash-lite, gemini-3.5-flash, or gemini-3.8-flash)
GEMINI_MODEL=gemini-3.1-flash-lite

# Fallback model (used when primary encounters 404 or repeated transient 5xx/429 failures)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Stage 2 Cross-page Reconciliation Model
GEMINI_RECONCILIATION_MODEL=gemini-3.5-flash
GEMINI_RECONCILIATION_TIMEOUT_SECONDS=30.0
GEMINI_RECONCILIATION_CHUNK_PAGES=10

# Upstream reliability & retry settings
GEMINI_MAX_RETRIES=2
GEMINI_BASE_RETRY_DELAY_SECONDS=1.0
GEMINI_MAX_RETRY_DELAY_SECONDS=8.0
GEMINI_MAX_TOTAL_RETRY_DURATION_SECONDS=25.0

# Application Configuration
APP_NAME="Maths Paper Parser"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# File Upload Settings
MAX_IMAGE_SIZE_MB=15
MAX_PDF_SIZE_MB=25
MAX_PDF_PAGES=20
PDF_RENDER_DPI=200
ALLOWED_EXTENSIONS=["jpg", "jpeg", "png", "webp", "pdf"]
